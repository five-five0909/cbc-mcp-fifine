{
  "name": "cbc-mcp",
  "version": "0.1.0",
  "description": "MCP server that drives CodeBuddy Code (cbc) with step-level control",
  "type": "module",
  "bin": {
    "cbc-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "smoke": "node test/smoke.mjs",
    "smoke:control": "node test/smoke-control.mjs",
    "smoke:steer": "node test/smoke-steer.mjs",
    "test": "npm run build && node test/smoke.mjs && node test/smoke-control.mjs && node test/smoke-steer.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
